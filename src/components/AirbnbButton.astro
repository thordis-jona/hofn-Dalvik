---
import SiteIcon from './SiteIcon.astro';
import { AIRBNB_LISTING_URL } from '../lib/site-links';

interface Props {
  extraClass?: string;
  label: string;
  ariaLabel: string;
}

const { extraClass = '', label, ariaLabel } = Astro.props;
const className = ['btn', 'btn-airbnb', extraClass].filter(Boolean).join(' ');
---

<a
  href={AIRBNB_LISTING_URL}
  class={className}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  data-track-airbnb="button"
>
  <span class="btn-airbnb__label">{label}</span>
  <SiteIcon name="arrow-up-right" />
</a>
